# Where the RxAuth AI API is. The Next.js server calls this; the browser never does.
RXAUTH_API_URL=http://localhost:8000

# Access token forwarded as `Authorization: Bearer`. Leave unset against a local
# API (RXAUTH_AUTH_ENABLED=false), which resolves the synthetic local principal
# itself. Staging and production require a real token — see src/lib/auth.ts.
# RXAUTH_API_TOKEN=

# Seconds to wait on the API before giving up. A case run is queued and polled,
# so no request the UI makes is a long one.
RXAUTH_API_TIMEOUT_SECONDS=15
